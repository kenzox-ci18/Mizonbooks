PORT=5000
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
JWT_SECRET=uzun-tasodifiy-sir-kalit-kamida-32-belgi
# Shu username egasi serverni ishga tushirganda avtomatik admin bo'ladi
ADMIN_USERNAME=sizning_username
# Google orqali kirish uchun (Google Cloud Console -> Credentials -> OAuth client ID -> Web application).
# "Authorized JavaScript origins" ga sayt manzilini qo'shing (masalan https://mizonbooks.uz va http://localhost:5000).
# Bo'sh qoldirilsa, Google tugmasi ko'rinmaydi, qolgan hammasi ishlayveradi.
GOOGLE_CLIENT_ID=
